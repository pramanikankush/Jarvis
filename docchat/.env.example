# Copy this file to `.env` and fill in the values.
# The app loads it automatically at startup (no dotenv dependency needed).
# Real environment variables always win over values in this file.
#
# The Groq API key can also be set in the app UI (Settings) — that value is
# stored in data/config.json and is overridden by GROQ_API_KEY when set.

GROQ_API_KEY=gsk_...

# Tavily web search API key (optional). When set, web search uses Tavily;
# when unset, the app falls back to keyless DuckDuckGo search.
# TAVILY_API_KEY=tvly_...

# Clerk authentication (optional). When CLERK_PUBLISHABLE_KEY is set, the app
# shows a Sign in button (Clerk) alongside the default guest workspace.
#   - CLERK_PUBLISHABLE_KEY (pk_...) is PUBLIC by design — it can appear in
#     the frontend bundle; it is served via /api/state.
#   - CLERK_SECRET_KEY (sk_...) is SECRET — it must stay server-side only; it
#     is used as a fallback verifier when the local JWKS check is unavailable.
#   - CLERK_FRONTEND_API defaults to the domain embedded in the publishable key
#     (https://<instance>.clerk.accounts.dev) — set only to override it.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev

# Free-demo chat limit: guests and Clerk users may keep at most N chats
# (existing chats keep working; delete one to free a slot). 0 = unlimited.
# The local workspace (owner) is never limited.
# DEMO_MAX_CHATS=3

# Optional overrides
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant   # retry model if the primary fails
# GROQ_STT_MODEL=whisper-large-v3-turbo      # speech-to-text model
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=troy                        # austin, hannah, jessica, sam, leo, mia...
# DOCCHAT_EMBED_MODEL=BAAI/bge-small-en-v1.5 # local embedding model
# PORT=8000
